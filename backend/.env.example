# NOVA AI Backend Configuration

# Server Port
PORT=5000

# Client Application URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Provider API Credentials
# Get your Google Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection (Optional, defaults to gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
